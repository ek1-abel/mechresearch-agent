LLM_PROVIDER=custom
LLM_MODEL_ID=your-model-id-here
LLM_BASE_URL=your-model-base-url-here
LLM_API_KEY=your-api-key-here
LLM_TIMEOUT=120

SEARCH_API=advanced

# TAVILY_API_KEY=your-tavily-key
SERPAPI_API_KEY=your-serpapi-key

# Optional: visual reviewer
# VISION_LLM_MODEL_ID=your-vision-model-id
# VISION_LLM_BASE_URL=your-vision-model-base-url
# VISION_LLM_API_KEY=your-vision-api-key
# VISION_LLM_TIMEOUT=120

# Knowledge base (requires qdrant-client)
ENABLE_RAG=false
RAG_KNOWLEDGE_BASE_PATH=./knowledge_base
RAG_COLLECTION_NAME=mech_research_kb
RAG_NAMESPACE=default
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# Report evaluation
ENABLE_EVALUATOR=true
